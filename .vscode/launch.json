{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": { 
                "PYTHONPATH": "${workspaceFolder}" 
            },
        },
        {
            "name": "Run Sim Timings",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/record_timings.py",
            "console": "integratedTerminal",
            "env": { 
                "PYTHONPATH": "${workspaceFolder}" 
            },
            "args": [
                "--num-cores", "${input:numCores}",
                "--output-dir", "${workspaceFolder}/results/timings/",
                "--tag", "${input:tag}"
            ]
        },
        {
            "name": "Run Simulations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_simulations.py",
            "console": "integratedTerminal",
            "env": { 
                "PYTHONPATH": "${workspaceFolder}" 
            },
            "args": [
                "--num-cores", "${input:numCores}"
            ]
        }
    ],
    
    "inputs": [
        { 
            "id": "numCores",
            "type": "pickString",
            "description": "Select number of CPU cores to use",
            "options": ["1", "2", "4", "8", "16", "32"],
            "default": "4"
        },
        { 
            "id": "tag",
            "type": "promptString",
            "description": "String tag to use for output files (or whatever else)",
        }
    ]
        
}